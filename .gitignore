__pycache__/
*.py[cod]
.pytest_cache/
.coverage
*.egg-info/
build/
dist/
.venv/
results/

# Literature PDFs: ~1.17 GB (111 files, measured 2026-08-01 -- the earlier
# "~617MB" here was from a 69-paper corpus and went stale as papers were added).
# Fully reproducible via scripts/fetch_literature.sh. The index and fetch log ARE
# tracked, so the corpus stays auditable -- note the log itself still ends
# "downloaded=69 ... total=69" and is a record of that run, not of the corpus.
papers/literature/*.pdf

# NIST PMI conformance suite: ~14 MB archive, 68 MB once extracted (33 .stp
# files). Reproducible via scripts/fetch_nist_pmi.py.
data/nist_pmi/

# Suite-integrity artifacts: regenerable, not tracked.
.coverage
htmlcov/
*.sqlite

# Held by tests/mutation_registry.mutation_lock() while a declared mutation has
# a src/ file mutated on disk; scripts/gate_a.py and
# scripts/check_suite_integrity.py refuse to start while it exists. Runtime
# state, never committed -- and if it were tracked, every mutation run would
# dirty the tree and trip the O-B finalizer in tests/conftest.py.
.mutation-in-progress
